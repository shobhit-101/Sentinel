# Sentinel backend — copy to .env and fill in.
# The API (index.js) and worker (worker.js) share this file.

# --- Database ---
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/sentinel

# --- Auth ---
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Redis ---
# Production: a single connection URL from managed Redis.
REDIS_URL=
# Local dev: used only when REDIS_URL is empty.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Third-party APIs ---
GROQ_API_KEY=
RESEND_API_KEY=
NINJAS_API_KEY=

# --- Deployment ---
# The deployed frontend origin. When set, CORS is pinned to it.
FRONTEND_URL=
# PORT is provided by the host (Render); leave unset locally.
